# FastBrain-owned, read-only bridge settings. This file does not alter Hermes.
FASTBRAIN_MEMORY_MODE=hybrid
FASTBRAIN_HINDSIGHT_CMD="/root/.hermes/installs/8a4017c4cabfe15f/environments/227feaf4b02f4f769987e9ff03d0ffaa/venv/bin/python3 /root/FastBrain/scripts/hindsight-direct.py"
FASTBRAIN_HINDSIGHT_TIMEOUT=5.0
FASTBRAIN_HINDSIGHT_LIMIT=3
# The bridge probes Termux commands through this bound host path only.
FASTBRAIN_TERMUX_BIN=/data/data/com.termux/files/usr/bin
# Prefer the native bridge when its manually-started service is healthy. It is
# never started by normal routing; `fastbrain native-bridge start` is explicit.
FASTBRAIN_NATIVE_BRIDGE_ENABLED=1
FASTBRAIN_NATIVE_BRIDGE_URL=http://127.0.0.1:8988/v1/action
FASTBRAIN_NATIVE_BRIDGE_AUTH_TOKEN_FILE=/data/data/com.termux/files/home/.fastbrain-native-bridge/auth.token
FASTBRAIN_NATIVE_BRIDGE_CONFIRMATION_KEY_FILE=/data/data/com.termux/files/home/.fastbrain-native-bridge/confirmation.key
FASTBRAIN_NATIVE_BRIDGE_LAUNCHER=/data/data/com.termux/files/home/.fastbrain-native-bridge/run-native-bridge.sh
FASTBRAIN_NATIVE_BRIDGE_SCHEDULER=/data/data/com.termux/files/usr/bin/termux-job-scheduler
FASTBRAIN_NATIVE_BRIDGE_JOB_ID=8903
FASTBRAIN_NATIVE_BRIDGE_TIMEOUT=4.5
